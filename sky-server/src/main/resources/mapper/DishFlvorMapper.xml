<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.DishFlvorMapper">

    <insert id="insert">
        insert into dish_flavor(dish_id,name,value) VALUES
        <foreach collection="flavors" index="index" item="df" separator=",">
            (#{df.dishId},#{df.name},#{df.value})
        </foreach>
    </insert>
    <delete id="deleteByids">
        delete from dish_flavor where dish_id in
        <foreach collection="ids" index="index" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>
    <delete id="deleteByid">
        delete from dish_flavor where dish_id = #{id}
    </delete>
    <select id="countByDishId" resultType="java.lang.Integer">
        select count(*) from dish_flavor where dish_id = #{dishId}
    </select>
    <select id="getByDishId" resultType="com.sky.entity.DishFlavor">
        select * from dish_flavor where dish_id = #{dishId}
    </select>
</mapper>